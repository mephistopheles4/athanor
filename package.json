{
  "name": "@mephistopheles4/athanor",
  "version": "0.1.1",
  "description": "Run a repo's tests on the tracked files in the working tree, uncommitted edits included, in a fresh Docker container, with a machine-wide run limit.",
  "license": "MIT",
  "author": "Ayman Diab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mephistopheles4/athanor.git"
  },
  "type": "module",
  "bin": {
    "athanor": "bin/athanor.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#dist/*": "./dist/*"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepack": "node scripts/build.mjs",
    "test": "node test/run.mjs fast",
    "test:docker": "node test/run.mjs docker",
    "check": "node scripts/check-source.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}

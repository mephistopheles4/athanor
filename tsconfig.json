{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "newLine": "lf",
    "noEmitOnError": true,
    "skipLibCheck": false
  },
  "include": ["src"]
}
